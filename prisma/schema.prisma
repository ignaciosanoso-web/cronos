generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH.JS (tablas requeridas por el adaptador) ============

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ USUARIOS ============

enum SubscriptionTier {
  FREE
  CURADOR
  CURADOR_PRO
}

enum UserRole {
  USER
  CURATOR
  ADMIN
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  emailVerified    DateTime?
  name             String?
  image            String?          // OAuth profile picture (required by Auth.js adapter)
  displayName      String?
  bio              String?          @db.Text
  avatarUrl        String?
  role             UserRole         @default(USER)
  subscriptionTier SubscriptionTier @default(FREE)
  stripeCustomerId String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  accounts      Account[]
  sessions      Session[]
  ownerships    Ownership[]
  bids          Bid[]
  petitions     Petition[]
  petitionVotes PetitionVote[]
  listings      Listing[]
  offersMade    Offer[]        @relation("OfferBuyer")
  notifications Notification[]

  @@index([email])
}

// ============ MOMENTOS HISTÓRICOS ============

enum Tier {
  MITICO
  EXCEPCIONAL
  RARO
  COMUN
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum MomentStatus {
  DRAFT
  SCHEDULED
  IN_AUCTION
  IN_VAULT
}

enum Era {
  PREHISTORIA
  MUNDO_ANTIGUO
  EDAD_MEDIA
  RENACIMIENTO
  ERA_INDUSTRIAL
  ERA_ESPACIAL
  ERA_DIGITAL
}

enum Category {
  CIENCIA
  ARTE
  GUERRA
  POLITICA
  EXPLORACION
}

model Moment {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  year             Int
  date             String
  era              Era
  category         Category
  tier             Tier
  confidence       Confidence   @default(MEDIUM)
  description      String       @db.Text
  procedence       String       @db.Text
  imageUrl         String
  location         String?
  totalCirculation Int
  basePrice        Int
  status           MomentStatus @default(DRAFT)
  sources          String[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdById      String?
  petitionId       String?      @unique
  petition         Petition?    @relation(fields: [petitionId], references: [id])

  auctions       Auction[]
  ownerships     Ownership[]
  contextEvents  ContextEvent[]

  @@index([year])
  @@index([tier])
  @@index([era])
  @@index([status])
}

model ContextEvent {
  id          String @id @default(cuid())
  momentId    String
  moment      Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  date        String
  title       String
  description String
  order       Int    @default(0)
}

// ============ SUBASTAS ============

enum AuctionStatus {
  SCHEDULED
  OPEN
  EXTENDING
  CLOSED_WON
  CLOSED_NO_BIDS
  CANCELLED
}

model Auction {
  id                String        @id @default(cuid())
  momentId          String
  moment            Moment        @relation(fields: [momentId], references: [id])
  serialNumber      Int
  startPrice        Int
  currentBidId      String?       @unique
  currentBid        Bid?          @relation("CurrentBid", fields: [currentBidId], references: [id])
  status            AuctionStatus @default(SCHEDULED)
  opensAt           DateTime
  baseClosesAt      DateTime
  closesAt          DateTime
  earlyAccessUntil  DateTime?
  earlyAccessUserId String?
  createdAt         DateTime      @default(now())

  bids Bid[] @relation("AllBids")

  @@index([status])
  @@index([closesAt])
}

enum BidStatus {
  ACTIVE
  OUTBID
  WON
  RELEASED
  HOLD_FAILED
}

model Bid {
  id                    String    @id @default(cuid())
  auctionId             String
  auction               Auction   @relation("AllBids", fields: [auctionId], references: [id])
  userId                String
  user                  User      @relation(fields: [userId], references: [id])
  amount                Int
  stripePaymentIntentId String?
  stripeError           String?
  status                BidStatus @default(ACTIVE)
  triggeredExtension    Boolean   @default(false)
  createdAt             DateTime  @default(now())

  currentInAuction Auction? @relation("CurrentBid")

  @@index([auctionId, createdAt])
  @@index([userId])
}

// ============ PROPIEDAD Y BÓVEDA ============

model Ownership {
  id                  String   @id @default(cuid())
  momentId            String
  moment              Moment   @relation(fields: [momentId], references: [id])
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  serialNumber        Int
  acquiredAt          DateTime @default(now())
  acquisitionPrice    Int
  originalAdquirentId String?
  isPublic            Boolean  @default(true)

  listings Listing[]

  @@unique([momentId, serialNumber])
  @@index([userId])
}

// ============ MERCADO SECUNDARIO ============

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

model Listing {
  id          String        @id @default(cuid())
  ownershipId String        @unique
  ownership   Ownership     @relation(fields: [ownershipId], references: [id])
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id])
  askingPrice Int
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())

  offers Offer[]
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

model Offer {
  id        String      @id @default(cuid())
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User        @relation("OfferBuyer", fields: [buyerId], references: [id])
  amount    Int
  message   String?     @db.Text
  status    OfferStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime    @default(now())
}

// ============ TRANSACCIONES ============

enum TxKind {
  AUCTION_WIN
  SECONDARY_SALE
  ROYALTY_PAYMENT
}

model Transaction {
  id                 String   @id @default(cuid())
  kind               TxKind
  momentId           String
  buyerId            String
  sellerId           String?
  grossAmount        Int
  cronosFee          Int
  sellerNet          Int
  royaltyAmount      Int
  royaltyRecipientId String?
  stripeChargeId     String?
  createdAt          DateTime @default(now())

  @@index([buyerId])
  @@index([sellerId])
  @@index([momentId])
}

// ============ PETICIONES ============

enum PetitionStatus {
  IN_REVIEW
  APPROVED_SCHEDULED
  ARCHIVED
}

model Petition {
  id               String         @id @default(cuid())
  proposerId       String
  proposer         User           @relation(fields: [proposerId], references: [id])
  proposedYear     Int
  proposedTitle    String
  justification    String         @db.Text
  sources          String[]
  status           PetitionStatus @default(IN_REVIEW)
  adminNotes       String?        @db.Text
  qualityScore     Int?
  approvedMomentId String?
  approvedMoment   Moment?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  votes PetitionVote[]

  @@index([status])
  @@index([createdAt])
}

model PetitionVote {
  id         String   @id @default(cuid())
  petitionId String
  petition   Petition @relation(fields: [petitionId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([petitionId, userId])
}

// ============ NOTIFICACIONES ============

enum NotifKind {
  AUCTION_WON
  AUCTION_LOST
  BID_OUTBID
  AUCTION_EXTENDED
  EARLY_ACCESS_GRANTED
  PETITION_STATUS_CHANGE
  ROYALTY_EARNED
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  kind      NotifKind
  payload   Json
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, sentAt])
}

// ============ AUDIT LOG ============

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
}
