{
  "name": "cronos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "seed": "tsx prisma/seed.ts",
    "open-auction": "tsx scripts/open-test-auction.ts",
    "inngest": "npx inngest-cli@latest dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "npm run seed"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^5.22.0",
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.6.0",
    "cloudinary": "^2.10.0",
    "inngest": "^4.4.0",
    "next": "15.5.18",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.21.0",
    "prisma": "^5.22.0",
    "pusher": "^5.3.3",
    "pusher-js": "^8.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^22.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
