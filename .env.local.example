# ============================================================
#  CRONOS — Variables de entorno
#  Copia este archivo como .env.local para desarrollo local
#  En Vercel añade cada variable desde el panel de Settings
# ============================================================

# ============ BASE DE DATOS (Neon / Postgres) ============
# Neon: https://console.neon.tech → New Project → Connection string
# Usar la variante "pooled" (puerto 6432) para Vercel Serverless
DATABASE_URL=postgresql://user:password@host/cronos?sslmode=require

# ============ AUTH.JS ============
# Genera el secreto con: openssl rand -base64 32
AUTH_SECRET=genera_con_openssl_rand_base64_32
# URL pública de la app (en Vercel se setea automáticamente como VERCEL_URL)
NEXTAUTH_URL=http://localhost:3000

# ============ GOOGLE OAUTH ============
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Authorized redirect URIs: https://tu-dominio.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============ RESEND (EMAIL) ============
# https://resend.com → API Keys → Create API Key
# Dominio verificado recomendado para producción (sino usa onboarding@resend.dev)
RESEND_API_KEY=re_...

# ============ STRIPE ============
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# stripe listen --forward-to localhost:3000/api/webhooks/stripe  →  te da este secreto
STRIPE_WEBHOOK_SECRET=whsec_...

# ============ PUSHER CHANNELS ============
# https://dashboard.pusher.com → Channels → New App
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# ============ CLOUDINARY ============
# https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============ INNGEST ============
# https://app.inngest.com → Settings → Event Keys  (producción)
# En desarrollo local déjalo vacío; Inngest Dev Server no requiere key
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
